MODE=development
POSTGRES_DB_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
COGNITO_CLIENT_ID=<public-app-client-id>
ALLOWED_ORIGINS_DEVELOPMENT=http://localhost:3000
BACKEND_WIKI_CACHE_TTL_DEVELOPMENT=300
REACT_APP_BACKEND_URL=http://localhost:8004
REACT_APP_COGNITO_DOMAIN=<hosted-ui-domain>
REACT_APP_COGNITO_CLIENT_ID=<public-app-client-id>
REACT_APP_COGNITO_REDIRECT_URI=http://localhost:3000
